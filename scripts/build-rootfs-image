#!/usr/bin/bash
set -euo pipefail

die() { echo "build-rootfs-image: $*" >&2; exit 1; }
[[ $# == 9 && $EUID == 0 ]] ||
  die 'usage: sudo build-rootfs-image SOURCE OUTPUT SIZE USER linux|userdata REPO_URL KEY_FILE FINGERPRINT FIRMWARE_PACKAGE'
source_root=$(realpath -e -- "$1")
output=$(realpath -m -- "$2")
size=$3
[[ $source_root != / && -f $source_root/etc/os-release ]] || die 'expected a mounted official Omarchy installation'
[[ $output != "$source_root"/* ]] || die 'the output must be outside the source root'
[[ ! -e $output && ! -L $output ]] || die 'the output path already exists'
[[ $size =~ ^[1-9][0-9]*[GM]$ ]] || die 'specify the ext4 size, for example 24G'
scripts=$(dirname -- "$(realpath -- "$0")")
mount_root=$(mktemp -d)
if ! image=$(mktemp "${output%/*}/.sheng-image.XXXXXXXX"); then
  rmdir "$mount_root"
  exit 1
fi
cleanup() {
  if mountpoint -q "$mount_root" && ! umount "$mount_root"; then
    echo "Staging image still mounted at $mount_root from $image" >&2
    return
  fi
  rmdir "$mount_root"
  rm -f -- "$image"
}
trap cleanup EXIT
truncate -s "$size" "$image"
mkfs.ext4 -O '^orphan_file,^metadata_csum_seed' "$image"
mount -o loop "$image" "$mount_root"
rsync -aHAX --numeric-ids \
  --exclude='/boot/*' --exclude='/efi/*' --exclude='/dev/*' --exclude='/proc/*' \
  --exclude='/sys/*' --exclude='/run/*' --exclude='/tmp/*' --exclude='/.snapshots/*' \
  --exclude='/swap/*' "$source_root/" "$mount_root/"
"$scripts/prepare-rootfs" "$mount_root" "${@:4}"
umount "$mount_root"
e2fsck -fn "$image"
mv -T --no-clobber -- "$image" "$output"
[[ ! -e $image ]] || die 'the output path was created during the build'
