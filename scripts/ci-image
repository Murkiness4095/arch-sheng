#!/usr/bin/bash
set -euo pipefail
cd /work
repo=${SHENG_REPO_URL:-file:///var/cache/sheng/repo}
local_repo=file:///var/cache/sheng/repo
partlabel=${SHENG_PARTLABEL:-linux}
profile=${SHENG_PROFILE:-tty}
username=${SHENG_USERNAME:-}
password=${SHENG_PASSWORD:-}
if [[ -n $username && ! $username =~ ^[a-z][a-z0-9_-]{0,30}$ || $username == root ]]; then
  echo 'Choose a non-root username with lowercase letters, digits, underscores or hyphens.' >&2
  exit 1
fi
if [[ -n $password && ( -z $username || $password == *$'\n'* || $password == *$'\r'* ) ]]; then
  echo 'A build-time password requires a username and must fit on one line.' >&2
  exit 1
fi
[[ $partlabel == linux || $partlabel == userdata ]]
[[ $repo == "$local_repo" || $repo =~ ^https://[^[:space:]\#]+$ ]]

pacman-key --init
pacman-key --populate archlinuxarm
printf 'Server = http://mirror.archlinuxarm.org/$arch/$repo\n' >/etc/pacman.d/mirrorlist
pacman --noconfirm --disable-sandbox -Syu --needed android-tools arch-install-scripts curl e2fsprogs gnupg
if [[ ${SHENG_WITH_FIRMWARE:-false} == true ]]; then
  pacman --noconfirm --disable-sandbox -S --needed base-devel
fi

work=$(mktemp -d /work/.sheng-image.XXXXXXXX)
target=$work/root
image=$work/root.img
cleanup() {
  if mountpoint -q "$target"; then
    umount "$target" || return
  fi
  rm -rf -- "$work"
}
trap cleanup EXIT
mkdir "$target"
truncate -s 20G "$image"
mkfs.ext4 -O '^orphan_file,^metadata_csum_seed' "$image"
mount -o loop "$image" "$target"

# The runner container may not expose Landlock to pacman.
mkdir "$work/bin"
printf '#!/bin/sh\nexec /usr/bin/pacman --disable-sandbox "$@"\n' > "$work/bin/pacman"
chmod 755 "$work/bin/pacman"
PATH="$work/bin:$PATH" pacstrap -c -G -M "$target" \
  base archlinuxarm-keyring e2fsprogs fastfetch linux-firmware-qcom mesa networkmanager sudo vim
install -m644 /etc/pacman.d/mirrorlist "$target/etc/pacman.d/mirrorlist"
install -m644 /etc/resolv.conf "$target/etc/resolv.conf"
in_target() { arch-chroot -r "$target" "$@"; }

printf 'PARTLABEL=%s / ext4 defaults,x-systemd.growfs 0 1\n' "$partlabel" > "$target/etc/fstab"
printf 'arch-sheng\n' > "$target/etc/hostname"
install -d "$target/etc/sheng" "$target/var/cache/sheng/repo" "$target/usr/share/sheng"
printf '%s\n' "$partlabel" > "$target/etc/sheng/partlabel"
cp -a /work/dist/packages/. "$target/var/cache/sheng/repo/"
install -m644 /work/dist/packages/sheng.{asc,fingerprint} "$target/usr/share/sheng/"
fingerprint=$(< /work/dist/packages/sheng.fingerprint)
[[ $fingerprint =~ ^[A-F0-9]{40}$ ]]
write_repo() {
  printf '[sheng]\nSigLevel = Required DatabaseRequired\nServer = %s\n' "${1%/}" > "$target/etc/pacman.d/sheng.conf"
}
write_repo "$local_repo"
printf '\nInclude = /etc/pacman.d/sheng.conf\n' >> "$target/etc/pacman.conf"
in_target pacman-key --init
in_target pacman-key --populate archlinuxarm
in_target pacman-key --add /usr/share/sheng/sheng.asc
in_target pacman-key --lsign-key "$fingerprint"

desktop=()
display_manager=
case "$profile" in
  tty) ;;
  gnome)
    desktop=(gnome-shell gnome-session gnome-control-center gdm nautilus gnome-console)
    display_manager=gdm.service
    ;;
  kde)
    desktop=(plasma-desktop plasma-workspace plasma-nm plasma-pa kde-gtk-config dolphin konsole sddm)
    display_manager=sddm.service
    ;;
  plasma-mobile)
    desktop=(plasma-mobile plasma-settings qmlkonsole dolphin xdg-desktop-portal-kde sddm)
    display_manager=sddm.service
    ;;
  niri)
    desktop=(niri sheng/noctalia noctalia-greeter greetd foot fuzzel xdg-desktop-portal-gnome xwayland-satellite)
    display_manager=greetd.service
    install -Dm644 profiles/niri/config.kdl "$target/etc/skel/.config/niri/config.kdl"
    ;;
  denial|denial-mobile)
    desktop=(denial/denial sheng/sheng-rotation vulkan-freedreno foot greetd greetd-agreety)
    if [[ ${SHENG_WITH_DROIDLOOM:-false} == true ]]; then
      printf "\n[droidloom]\nSigLevel = Never\nServer = https://denialwm.github.io/droidloom/\$arch\nCacheServer = https://github.com/denialwm/droidloom/releases/download/packages\n" >> "$target/etc/pacman.conf"
      desktop+=(droidloom/droidloom-runtime droidloom/droidloom-image)
    fi
    display_manager=greetd.service
    curl -fsSL --retry 3 https://denialwm.github.io/denial/denial-repo-key.asc -o "$work/denial.asc"
    expected=AE4108FA5E91E26BE0EE331E0F5B3AD16E023091
    actual=$(gpg --batch --with-colons --show-keys "$work/denial.asc" |
      awk -F: '$1=="pub"{primary=1} $1=="fpr"&&primary{print $10;primary=0}')
    [[ $actual == "$expected" ]]
    install -m644 "$work/denial.asc" "$target/usr/share/sheng/denial.asc"
    in_target pacman-key --add /usr/share/sheng/denial.asc
    in_target pacman-key --lsign-key "$expected"
    printf '\n[denial]\nSigLevel = Required DatabaseRequired\nServer = https://denialwm.github.io/denial/$arch\n' >> "$target/etc/pacman.conf"
    ;;
  *) echo "Unknown desktop profile: $profile" >&2; exit 1 ;;
esac
if [[ -n $display_manager ]]; then
  desktop+=(firefox noto-fonts noto-fonts-cjk pipewire-pulse wireplumber sheng/sheng-audio sound-theme-freedesktop xdg-desktop-portal-gtk
    bluez bluez-utils upower power-profiles-daemon sheng/xiaomi-pen-status
    fcitx5 fcitx5-rime fcitx5-gtk fcitx5-qt fcitx5-configtool rime-luna-pinyin)
  skel=$target/etc/skel/.config
  install -Dm644 profiles/common/fcitx5-profile "$skel/fcitx5/profile"
  install -d "$target/etc/environment.d"
  ime_environment=$target/etc/environment.d/70-sheng-input-method.conf
  printf 'XMODIFIERS=@im=fcitx\n' > "$ime_environment"
  if [[ $profile == kde ]]; then
    # KWin owns the input-method process for native Plasma Wayland clients.
    printf '[Wayland]\nInputMethod=/usr/share/applications/org.fcitx.Fcitx5.desktop\n' > "$skel/kwinrc"
    install -d "$skel/autostart"
    printf '[Desktop Entry]\nHidden=true\n' > "$skel/autostart/org.fcitx.Fcitx5.desktop"
  else
    install -Dm644 profiles/common/fcitx5-autostart.desktop "$skel/autostart/org.fcitx.Fcitx5.desktop"
  fi
  case "$profile" in
    gnome|niri)
      printf 'QT_IM_MODULES="wayland;fcitx"\n' >> "$ime_environment"
      ;;
    denial)
      printf 'GTK_IM_MODULE=fcitx\nQT_IM_MODULE=fcitx\n' >> "$ime_environment"
      ;;
  esac
fi

if [[ ${SHENG_WITH_FIRMWARE:-false} == true ]]; then
  useradd -m builder
  cp -r packages/sheng-firmware "$work/firmware"
  chmod 755 "$work"
  chown -R builder:builder "$work/firmware"
  (
    cd "$work/firmware"
    runuser -u builder -- makepkg --noconfirm
  )
  install -d "$target/var/cache/sheng/firmware"
  install -m644 "$work/firmware/"*.pkg.tar.* "$target/var/cache/sheng/firmware/"
  archives=("$target/var/cache/sheng/firmware/"*.pkg.tar.*)
  in_target pacman -U --noconfirm --disable-sandbox "${archives[0]#"$target"}"
  rm -r "$target/var/cache/sheng/firmware"
fi

in_target pacman -Syu --noconfirm --disable-sandbox --needed sheng/arch-sheng sheng/linux-sheng sheng/xiaomi-sheng-thp sheng/sheng-devauth "${desktop[@]}"
case "$profile" in
  plasma-mobile)
    mobile_session=/usr/share/wayland-sessions/plasma-mobile.desktop
    [[ -f $target$mobile_session ]]
    chroot "$target" install -d -o sddm -g sddm /var/lib/sddm
    printf '[Last]\nSession=%s\n' "$mobile_session" > "$target/var/lib/sddm/state.conf"
    chroot "$target" chown sddm:sddm /var/lib/sddm/state.conf
    ;;
  denial-mobile)
    printf '\nDENIAL_SHELL_PROFILE=mobile\n' >> "$target/etc/denial/session.conf"
    ;;
esac
case "$profile" in
  niri)
    [[ -x $target/usr/bin/noctalia-greeter-session ]]
    cat > "$target/etc/greetd/config.toml" <<'TOML'
[terminal]
vt = 1

[default_session]
command = "/usr/bin/noctalia-greeter-session -- --session niri"
user = "greeter"
TOML
    ;;
  denial|denial-mobile)
    in_target sheng-denial-login "$username"
    in_target systemctl enable sheng-sensorspd.service steinerd.service
    ;;
esac
in_target sheng-boot install
if [[ $repo != "$local_repo" ]]; then
  write_repo "$repo"
  rm -r "$target/var/cache/sheng/repo"
fi

# Generate per-device signing trust and create the first user on the console.
install -Dm755 scripts/first-login "$target/usr/lib/sheng/first-login"
install -d "$target/etc/sudoers.d"
printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$target/etc/sudoers.d/10-sheng-wheel"
chmod 440 "$target/etc/sudoers.d/10-sheng-wheel"
in_target visudo -c
chroot "$target" systemctl set-default multi-user.target
if [[ -n $display_manager ]]; then
  chroot "$target" systemctl enable "$display_manager" bluetooth.service power-profiles-daemon.service
  touch "$target/etc/sheng/graphical"
fi
if [[ -n $username ]]; then
  if in_target getent passwd "$username" >/dev/null; then
    echo "The username '$username' is already reserved by the image." >&2
    exit 1
  fi
  in_target useradd -m -G wheel -s /usr/bin/bash "$username"
  printf '%s\n' "$username" > "$target/var/lib/sheng/first-user"
  if [[ -n $password ]]; then
    printf '%s:%s\n' "$username" "$password" | in_target chpasswd
    touch "$target/var/lib/sheng/console-initialized"
    if [[ -n $display_manager ]]; then
      chroot "$target" systemctl set-default graphical.target
    fi
  fi
fi
unset password SHENG_PASSWORD
install -d "$target/etc/systemd/system/getty@tty1.service.d"
cat > "$target/etc/systemd/system/getty@tty1.service.d/sheng-first-login.conf" <<'UNIT'
[Service]
ExecStartPre=/usr/bin/bash -ec '/usr/lib/sheng/first-login </dev/tty1 >/dev/tty1 2>&1'
UNIT
chroot "$target" systemctl enable sheng-keyring.service NetworkManager.service systemd-resolved.service xiaomi-sheng-thp.service
if [[ ${SHENG_WITH_FIRMWARE:-false} == true ]]; then
  chroot "$target" systemctl enable sheng-devauth.service
fi
ln -sfn /run/systemd/resolve/stub-resolv.conf "$target/etc/resolv.conf"
in_target gpgconf --homedir /etc/pacman.d/gnupg --kill all
rm -r "$target/etc/pacman.d/gnupg"
truncate -s 0 "$target/etc/machine-id"
umount "$target"
install -d dist/image
bash scripts/sparse-rootfs "$image" "dist/image/rootfs-$partlabel-$profile.img"
chown -R "$BUILD_UID:$BUILD_GID" dist/image
