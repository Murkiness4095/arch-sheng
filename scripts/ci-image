#!/usr/bin/bash
set -euo pipefail
cd /work
repo=${SHENG_REPO_URL:-file:///var/cache/sheng/repo}
local_repo=file:///var/cache/sheng/repo
partlabel=${SHENG_PARTLABEL:-linux}
[[ $partlabel == linux || $partlabel == userdata ]]
[[ $repo == "$local_repo" || $repo =~ ^https://[^[:space:]\#]+$ ]]

pacman-key --init
pacman-key --populate archlinuxarm
printf 'Server = http://mirror.archlinuxarm.org/$arch/$repo\n' >/etc/pacman.d/mirrorlist
pacman --noconfirm --disable-sandbox -Syu --needed arch-install-scripts e2fsprogs gnupg zstd
if [[ ${SHENG_WITH_FIRMWARE:-false} == true ]]; then
  pacman --noconfirm --disable-sandbox -S --needed base-devel
fi

work=$(mktemp -d /work/.sheng-image.XXXXXXXX)
target=$work/root
image=$work/root.img
cleanup() {
  if mountpoint -q "$target"; then
    umount "$target" || return
  fi
  rm -rf -- "$work"
}
trap cleanup EXIT
mkdir "$target"
truncate -s 20G "$image"
mkfs.ext4 -O '^orphan_file,^metadata_csum_seed' "$image"
mount -o loop "$image" "$target"

# The runner container may not expose Landlock to pacman.
mkdir "$work/bin"
printf '#!/bin/sh\nexec /usr/bin/pacman --disable-sandbox "$@"\n' > "$work/bin/pacman"
chmod 755 "$work/bin/pacman"
PATH="$work/bin:$PATH" pacstrap -c -G -M "$target" \
  base archlinuxarm-keyring e2fsprogs linux-firmware-qcom mesa networkmanager sudo vim
install -m644 /etc/pacman.d/mirrorlist "$target/etc/pacman.d/mirrorlist"
install -m644 /etc/resolv.conf "$target/etc/resolv.conf"
in_target() { arch-chroot -r "$target" "$@"; }

printf 'PARTLABEL=%s / ext4 defaults,x-systemd.growfs 0 1\n' "$partlabel" > "$target/etc/fstab"
printf 'arch-sheng\n' > "$target/etc/hostname"
install -d "$target/etc/sheng" "$target/var/cache/sheng/repo" "$target/usr/share/sheng"
printf '%s\n' "$partlabel" > "$target/etc/sheng/partlabel"
cp -a /work/dist/packages/. "$target/var/cache/sheng/repo/"
install -m644 /work/dist/packages/sheng.{asc,fingerprint} "$target/usr/share/sheng/"
fingerprint=$(< /work/dist/packages/sheng.fingerprint)
[[ $fingerprint =~ ^[A-F0-9]{40}$ ]]
write_repo() {
  printf '[sheng]\nSigLevel = Required DatabaseRequired\nServer = %s\n' "${1%/}" > "$target/etc/pacman.d/sheng.conf"
}
write_repo "$local_repo"
printf '\nInclude = /etc/pacman.d/sheng.conf\n' >> "$target/etc/pacman.conf"
in_target pacman-key --init
in_target pacman-key --populate archlinuxarm
in_target pacman-key --add /usr/share/sheng/sheng.asc
in_target pacman-key --lsign-key "$fingerprint"

if [[ ${SHENG_WITH_FIRMWARE:-false} == true ]]; then
  useradd -m builder
  cp -r packages/sheng-firmware "$work/firmware"
  chmod 755 "$work"
  chown -R builder:builder "$work/firmware"
  (
    cd "$work/firmware"
    runuser -u builder -- makepkg --noconfirm
  )
  install -d "$target/var/cache/sheng/firmware"
  install -m644 "$work/firmware/"*.pkg.tar.* "$target/var/cache/sheng/firmware/"
  archives=("$target/var/cache/sheng/firmware/"*.pkg.tar.*)
  in_target pacman -U --noconfirm --disable-sandbox "${archives[0]#"$target"}"
  rm -r "$target/var/cache/sheng/firmware"
fi

in_target pacman -Syu --noconfirm --disable-sandbox --needed sheng/arch-sheng sheng/linux-sheng sheng/xiaomi-sheng-thp
in_target sheng-boot install
if [[ $repo != "$local_repo" ]]; then
  write_repo "$repo"
  rm -r "$target/var/cache/sheng/repo"
fi

# Generate per-device signing trust and set the initial password on the
# physical console. The image ships with a locked root account.
install -d "$target/etc/systemd/system/getty@tty1.service.d"
cat > "$target/etc/systemd/system/getty@tty1.service.d/sheng-first-login.conf" <<'UNIT'
[Service]
ExecStartPre=/usr/bin/bash -ec 'test -e /var/lib/sheng/console-initialized || { /usr/bin/passwd root </dev/tty1 >/dev/tty1 2>&1; touch /var/lib/sheng/console-initialized; }'
UNIT
chroot "$target" systemctl enable sheng-keyring.service NetworkManager.service systemd-resolved.service xiaomi-sheng-thp.service
ln -sfn /run/systemd/resolve/stub-resolv.conf "$target/etc/resolv.conf"
in_target gpgconf --homedir /etc/pacman.d/gnupg --kill all
rm -r "$target/etc/pacman.d/gnupg"
truncate -s 0 "$target/etc/machine-id"
umount "$target"
e2fsck -fn "$image"
install -d dist/image
zstd -T0 -6 "$image" -o "dist/image/rootfs-$partlabel.img.zst"
(cd dist/image && sha256sum ./*.img.zst > SHA256SUMS)
chown -R "$BUILD_UID:$BUILD_GID" dist/image
