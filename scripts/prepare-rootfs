#!/usr/bin/bash
set -euo pipefail

die() { echo "prepare-rootfs: $*" >&2; exit 1; }

[[ $# == 7 && $EUID == 0 ]] ||
  die 'usage: sudo prepare-rootfs MOUNTED_ROOT USER linux|userdata REPO_URL KEY_FILE FINGERPRINT FIRMWARE_PACKAGE'
target=$(realpath -e -- "$1")
user=$2
partlabel=$3
repo=$4
key=$(realpath -e -- "$5")
fingerprint=${6^^}
firmware=$7
[[ $firmware == - ]] || firmware=$(realpath -e -- "$firmware")
[[ $target != / && $target != *[[:space:]]* ]] || die 'use a separate mount path without whitespace'
[[ $(findmnt -n -o FSTYPE --mountpoint "$target") == ext4 ]] || die 'mount an ext4 staging root first'
[[ $(stat -c %d /) != "$(stat -c %d "$target")" ]] || die 'the staging root must be on a separate device'
[[ $partlabel == linux || $partlabel == userdata ]] || die 'expected linux or userdata'
[[ $repo == file:///var/cache/sheng/repo || $repo =~ ^https://[^[:space:]\#]+$ ]] ||
  die 'expected an HTTPS repository URL or the embedded preview repository'
[[ $fingerprint =~ ^([A-F0-9]{40}|[A-F0-9]{64})$ ]] || die 'expected a full signing key fingerprint'
[[ $user == - || $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die 'invalid username'

in_target() { arch-chroot -r "$target" "$@"; }
[[ $(in_target uname -m) == aarch64 ]] || die 'run on an aarch64 build host'
in_target pacman -Q omarchy omarchy-settings >/dev/null || die 'start from an official stable ARM64 installation'
if [[ $user == - ]]; then
  [[ -e $target/var/lib/omarchy/provisioning/pending ]] || die 'arm first-boot provisioning in the source first'
else
  home=$(in_target getent passwd "$user" | cut -d: -f6)
  [[ $home == "/home/$user" ]] || die 'expected a regular user home under /home'
fi

# Verify the one primary key present in the operator-supplied key file.
gnupg=$(mktemp -d)
trap 'rm -rf -- "$gnupg"' EXIT
actual=$(gpg --homedir "$gnupg" --batch --with-colons --show-keys "$key" |
  awk -F: '$1=="pub" { primary=1 } $1=="fpr" && primary { print $10; primary=0 }')
[[ $actual == "$fingerprint" ]] || die 'signing key fingerprint mismatch'

# Keep the installer-generated config available when diagnosing the staging image.
cp -n "$target/etc/fstab" "$target/etc/fstab.omarchy-original"
printf 'PARTLABEL=%s / ext4 defaults,x-systemd.growfs 0 1\n' "$partlabel" > "$target/etc/fstab"
install -d "$target/etc/sheng" "$target/etc/pacman.d/hooks"
printf '%s\n' "$partlabel" > "$target/etc/sheng/partlabel"
build_server=$repo
if [[ -n ${SHENG_BUILD_REPO:-} ]]; then
  install -d "$target/var/cache/sheng/repo"
  cp -a "$SHENG_BUILD_REPO/." "$target/var/cache/sheng/repo/"
  build_server=file:///var/cache/sheng/repo
fi
printf '[sheng]\nSigLevel = Required DatabaseRequired\nServer = %s\n' "${build_server%/}" > "$target/etc/pacman.d/sheng.conf"
if ! grep -Fxq 'Include = /etc/pacman.d/sheng.conf' "$target/etc/pacman.conf"; then
  printf '\nInclude = /etc/pacman.d/sheng.conf\n' >> "$target/etc/pacman.conf"
fi

# Omarchy keeps Limine packages as runtime dependencies. Mask their ALPM
# deployment hooks in the extlinux installation.
for hook in 60-mkinitcpio-remove 60-limine-mkinitcpio-remove-pre 80-limine-efi-deploy \
    90-limine-mkinitcpio-remove-post 90-mkinitcpio-install 99-omarchy-limine; do
  ln -sfn /dev/null "$target/etc/pacman.d/hooks/$hook.hook"
done

# The key becomes trusted in this image only after fingerprint verification.
# arch-chroot mounts a temporary filesystem over /tmp on each invocation.
staging=$(mktemp -d "$target/var/cache/sheng-install.XXXXXXXX")
resolver=$target/etc/resolv.conf
restore_resolver() {
  rm -f -- "$resolver"
  if [[ -e $staging/resolv.conf || -L $staging/resolv.conf ]]; then
    mv -T -- "$staging/resolv.conf" "$resolver" || return 1
  fi
  rm -rf -- "$gnupg" "$staging"
}
chmod 755 "$staging"
if [[ -e $resolver || -L $resolver ]]; then
  mv -T -- "$resolver" "$staging/resolv.conf"
fi
trap restore_resolver EXIT
# The staged system may point resolv.conf into /run, where its resolver is
# absent during the build. Use the build host's DNS only for this transaction.
install -m644 /etc/resolv.conf "$resolver"
install -m644 "$key" "$staging/sheng.asc"
in_target pacman-key --add "${staging#"$target"}/sheng.asc"
in_target pacman-key --lsign-key "$fingerprint"
if [[ $firmware != - ]]; then
  install -m644 "$firmware" "$staging/${firmware##*/}"
  firmware_path=${staging#"$target"}/${firmware##*/}
  [[ $(in_target pacman -Qqp "$firmware_path") == sheng-firmware ]] || die 'expected a locally built sheng-firmware package'
  in_target pacman -U --noconfirm --disable-sandbox --needed "$firmware_path"
fi
in_target pacman -Syu --noconfirm --disable-sandbox --needed sheng/omarchy-sheng sheng/linux-sheng sheng/xiaomi-sheng-thp
chroot "$target" systemctl enable xiaomi-sheng-thp.service
# PostTransaction failures can leave the package installed. Verify or rebuild.
in_target sheng-boot install
if [[ $user == - ]]; then
  install -Dm644 "$target/usr/share/sheng/pre-refresh-sheng" \
    "$target/etc/skel/.config/omarchy/hooks/pre-refresh-pacman.d/sheng"
else
  in_target runuser -u "$user" -- install -Dm644 /usr/share/sheng/pre-refresh-sheng \
    "$home/.config/omarchy/hooks/pre-refresh-pacman.d/sheng"
fi
if [[ $user == - ]]; then
  install -m644 "$key" "$target/usr/share/sheng/repo.asc"
  printf "%s\n" "$fingerprint" > "$target/usr/share/sheng/repo.fingerprint"
  chroot "$target" systemctl enable sheng-keyring.service
  in_target gpgconf --homedir /etc/pacman.d/gnupg --kill all
  rm -rf -- "$target/etc/pacman.d/gnupg"
fi
if [[ $build_server != "$repo" ]]; then
  printf '[sheng]\nSigLevel = Required DatabaseRequired\nServer = %s\n' "${repo%/}" > "$target/etc/pacman.d/sheng.conf"
  rm -rf -- "$target/var/cache/sheng/repo"
fi
