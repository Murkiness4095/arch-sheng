pkgname=libssc
pkgver=0.4.4
pkgrel=1
pkgdesc='Client library for Qualcomm Sensor Core'
arch=(aarch64)
url=https://codeberg.org/DylanVanAssche/libssc
license=(GPL-3.0-or-later)
depends=(glib2 libqmi protobuf-c)
makedepends=(meson ninja pkgconf protobuf python)
_commit=033e2a32095c024d6dbdfb1d4ae1db4a94be32f1
source=("libssc-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=(80eb911009fccea52ab0ea0dcc78572a00757abd840e8dc81e9b72cd230526b8)

build() {
  arch-meson libssc build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
