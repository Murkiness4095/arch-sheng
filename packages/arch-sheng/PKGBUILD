depends=(gawk bash coreutils grep kmod mkinitcpio pacman util-linux)
source=(40-sheng-repository.hook sheng-boot sheng-repo mkinitcpio-sheng.conf 90-sheng-kernel.hook sheng-init-keyring sheng-keyring.service sheng-module-retention.conf sheng-denial-login)
sha256sums=(38d1275a9e10a04856ec1f50d2ee7e16bf583e74e5dc1ba57608022167058a25 93c2b782535dfbe9a77c526ad47797d186d001214d3c7218e93a5320d3f77dc0 879a0a7a26a5c13013ec3ec159354619b4d07a16cf01cc00757cf367a481102d 3f51994ef851e4a09e7c463332c3847a0eb264a1e78d9acc6dbb864b52d3586e c8d43936cfbf5744bf13e15ab300346c5b589210adc0282e5ffe14a030f22c69 364284b6c5ac365600a35b410aa036771d7efcf352aea67cf80bdda4deb6eed9 5ac0ee8fa86c896658fddc0ae8137be54bb4f7b64c6d1abbd1c9b3afeae657c4 dfffc463f65e1b821d7b7dc9f43781bd90e7abe2996de1f504980f69ee7e9a71 98d8152a116278c2c43e6619e3822bfa1a89cb308511fcb09c329b5bac1d34e8)

package() {
  install -Dm755 sheng-boot "$pkgdir/usr/bin/sheng-boot"
  install -Dm755 sheng-repo "$pkgdir/usr/bin/sheng-repo"
  install -Dm755 sheng-denial-login "$pkgdir/usr/bin/sheng-denial-login"
  install -Dm644 mkinitcpio-sheng.conf "$pkgdir/usr/share/sheng/mkinitcpio.conf"
  install -Dm644 90-sheng-kernel.hook "$pkgdir/usr/share/libalpm/hooks/90-sheng-kernel.hook"
  install -Dm644 40-sheng-repository.hook "$pkgdir/usr/share/libalpm/hooks/40-sheng-repository.hook"
  install -Dm755 sheng-init-keyring "$pkgdir/usr/lib/sheng/init-keyring"
  install -Dm644 sheng-keyring.service "$pkgdir/usr/lib/systemd/system/sheng-keyring.service"
  install -Dm644 sheng-module-retention.conf \
    "$pkgdir/usr/lib/systemd/system/linux-modules-cleanup.service.d/sheng.conf"
}
