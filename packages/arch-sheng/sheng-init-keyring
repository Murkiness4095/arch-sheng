#!/usr/bin/bash
set -euo pipefail
pacman-key --init
pacman-key --populate archlinuxarm
pacman-key --add /usr/share/sheng/sheng.asc
pacman-key --lsign-key "$(< /usr/share/sheng/sheng.fingerprint)"
if [[ -f /usr/share/sheng/denial.asc ]]; then
  pacman-key --add /usr/share/sheng/denial.asc
  pacman-key --lsign-key AE4108FA5E91E26BE0EE331E0F5B3AD16E023091
fi
touch /var/lib/sheng/keyring-initialized
