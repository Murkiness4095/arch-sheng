--- a/packages/denial_flutter_sdk/lib/src/services/power_profiles_client.dart
+++ b/packages/denial_flutter_sdk/lib/src/services/power_profiles_client.dart
@@ -74,6 +74,21 @@ final class PowerProfilesEndpoint {
     }
   }
 
+  Future<Set<String>> readAvailableProfiles() async {
+    final value = await _object.getProperty(_interface, 'Profiles').timeout(_timeout);
+    if (value is! DBusArray) return {};
+    const profileKey = DBusString('Profile');
+    final profiles = <String>{};
+    for (final entry in value.children.whereType<DBusDict>()) {
+      final field = entry.children[profileKey];
+      if (field is DBusVariant && field.value is DBusString) {
+        final profile = PowerProfile.normalize((field.value as DBusString).value);
+        if (profile != null) profiles.add(profile);
+      }
+    }
+    return profiles;
+  }
+
   Future<void> setActiveProfile(String profile) => _object
       .setProperty(_interface, 'ActiveProfile', DBusString(profile))
       .timeout(_timeout);
