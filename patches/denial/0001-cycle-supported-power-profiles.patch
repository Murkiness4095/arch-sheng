   /// The active profile, or null when no power-profile service answers.
   Future<String?> read() => _client.readActiveProfile();
 
+  /// Cycles through the modes the daemon actually exposes, in shell order.
+  Future<String?> cycle() async {
+    final current = await read();
+    final endpoint = await _client.resolve();
+    if (current == null || endpoint == null) return current;
+    try {
+      final available = await endpoint.readAvailableProfiles();
+      var candidate = PowerProfile.next(current);
+      while (candidate != current) {
+        if (available.contains(candidate)) {
+          await write(candidate);
+          break;
+        }
+        candidate = PowerProfile.next(candidate);
+      }
+    } on Object {
+      // Keep the tile in sync with the daemon if discovery fails.
+    }
+    return read();
+  }
+
